# REFERENCE ONLY. Do not upload this template as-is or commit completed values.
# Existing Neon project autumn-truth-83338737; branch br-plain-thunder-azzkcek5.
# Project region aws-ap-southeast-1; private bucket milaan-private-receipts.
# Obtain exact connection hosts, database/role, S3 endpoint and signing region
# from the EXISTING branch's console. Project and branch IDs are not hostnames.
APP_ENV=production
PUBLIC_ORIGIN=https://REPLACE_APPROVED_RENDER_OR_CUSTOM_HOST
CORS_ORIGINS=https://REPLACE_APPROVED_RENDER_OR_CUSTOM_HOST
SESSION_COOKIE_SECURE=true
REQUIRE_EMAIL_VERIFICATION=true
ALLOW_REGISTRATION=false
ENABLE_DEMO=false
DEMO_SELLER_EMAIL=
DEMO_SELLER_PASSWORD=
DATABASE_URL=postgresql+psycopg://REPLACE_RUNTIME_ROLE:REPLACE_URL_ENCODED_PASSWORD@REPLACE_POOLER_HOST/REPLACE_DATABASE?sslmode=verify-full&sslrootcert=system
MIGRATION_DATABASE_URL=postgresql+psycopg://REPLACE_MIGRATION_ROLE:REPLACE_URL_ENCODED_PASSWORD@REPLACE_DIRECT_HOST/REPLACE_DATABASE?sslmode=verify-full&sslrootcert=system
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://REPLACE_EXACT_NEON_S3_ENDPOINT
S3_BUCKET=milaan-private-receipts
S3_REGION=ap-southeast-1
S3_PREFIX=milaan/receipts/v1/
S3_ADDRESSING_STYLE=path
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
RUN_WORKER_IN_API=true
BATCH_RETENTION_HOURS=168
SESSION_HOURS=12
EXTRACTION_PROVIDER=manual
GEMINI_API_KEY=
GEMINI_MODEL=

# Resend HTTPS transactional email. Never put a real key in source control.
RESEND_API_KEY=
EMAIL_FROM=Milaan <no-reply@REPLACE_VERIFIED_DOMAIN.example>
EMAIL_DELIVERY_VERIFIED=false
# Keep closed until an authorized operator verifies live inbox delivery.
