# Copy to the ignored root .env.production; provide actual values securely.
MILAAN_DOMAIN=milaan.example.com
APP_ENV=production
PUBLIC_ORIGIN=https://milaan.example.com
SESSION_COOKIE_SECURE=true
REQUIRE_EMAIL_VERIFICATION=true
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=Milaan <no-reply@example.com>
SMTP_USER=
SMTP_PASSWORD=
# No demo operator credentials. Existing users must have verified account ownership.

# PostgreSQL runtime: pooled endpoint; migrations: direct endpoint (same database).
DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_POOLER_HOST/REPLACE_DATABASE?sslmode=verify-full&sslrootcert=system
MIGRATION_DATABASE_URL=postgresql+psycopg://REPLACE_USER:REPLACE_PASSWORD@REPLACE_DIRECT_HOST/REPLACE_DATABASE?sslmode=verify-full&sslrootcert=system
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0
ALLOW_REGISTRATION=false
ENABLE_DEMO=false
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://REPLACE_NEON_S3_ENDPOINT
S3_REGION=ap-southeast-1
S3_BUCKET=milaan-private-receipts
S3_PREFIX=milaan/receipts/v1/
S3_ADDRESSING_STYLE=path
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
EXTRACTION_PROVIDER=manual
