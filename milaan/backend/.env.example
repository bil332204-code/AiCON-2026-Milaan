# Copy to .env. Never commit .env or put these settings in frontend JavaScript.
DATABASE_URL=sqlite:///./data/milaan.db
STORAGE_DIR=./data/uploads
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000
RUN_WORKER_IN_API=true
ALLOW_REGISTRATION=true
ENABLE_DEMO=true
SESSION_HOURS=12
# Batches AND their financial records/receipts automatically expire after 7 days.
BATCH_RETENTION_HOURS=168
# manual mode works without a paid API/key. For vision extraction change to gemini.
EXTRACTION_PROVIDER=manual
GEMINI_API_KEY=
# Choose an available model supporting images and structured JSON in your account.
GEMINI_MODEL=
# Docker only: set a long random password before using docker compose.
POSTGRES_PASSWORD=

# Email verification for NEW signups (existing accounts keep working).
REQUIRE_EMAIL_VERIFICATION=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Local demo operator: configured by SETUP.bat, no shared default password.
DEMO_SELLER_EMAIL=
DEMO_SELLER_PASSWORD=

# Integrated browser authentication (development is loopback-only).
APP_ENV=development
PUBLIC_ORIGIN=http://127.0.0.1:8000
SESSION_COOKIE_SECURE=false
# Production requires APP_ENV=production, an HTTPS PUBLIC_ORIGIN, secure cookies,
# email verification, no demo provisioning and an exact production CORS origin.

# Optional durable services. Default SQLite + local receipts remains development-only.
# Production requires PostgreSQL + HTTPS private S3. See deploy/render-neon.env.example.
# DATABASE_URL=postgresql+psycopg://USER:ENCODED_PASSWORD@POOLER_HOST/DATABASE?sslmode=verify-full&sslrootcert=system
# MIGRATION_DATABASE_URL=postgresql+psycopg://USER:ENCODED_PASSWORD@DIRECT_HOST/DATABASE?sslmode=verify-full&sslrootcert=system
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=0
STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=
S3_PREFIX=receipts/v1/
S3_ADDRESSING_STYLE=path
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=
